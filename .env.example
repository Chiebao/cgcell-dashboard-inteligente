# Modelo de variáveis de ambiente.
# Para usar: copie este arquivo para ".env" e ajuste os valores, se precisar.
# O ".env" é ignorado pelo Git e nunca deve ser publicado.

# Caminho do arquivo do banco SQLite.
# Pode ser relativo à raiz do projeto ou absoluto. Padrão: data/cgcell.db
CGCELL_CAMINHO_BANCO=data/cgcell.db
